# Configurazione del servizio (copiata in /etc/registro-presenze.env alla prima installazione).
PORTA=8787
INDIRIZZO=0.0.0.0
DATI=/var/lib/registro-presenze
# Ora italiana dei controlli serali e del backup giornaliero.
ORA_CONTROLLI=23:30
BACKUP_GIORNI=30
# Mettere 1 solo se davanti c'è un reverse proxy HTTPS (Caddy, nginx) che imposta X-Forwarded-Proto.
PROXY_HTTPS=0
