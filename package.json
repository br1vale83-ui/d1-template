{
	"name": "registro-presenze",
	"description": "Registrazione digitale di presenze, ferie, permessi, malattia e infortuni su Cloudflare Workers + D1.",
	"cloudflare": {
		"label": "Worker + D1 Database",
		"products": [
			"Workers",
			"D1"
		],
		"categories": [
			"storage"
		],
		"docs_url": "https://developers.cloudflare.com/d1/",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/6c63cca8-354a-4951-45a0-d58769ac6f00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/aa6158f1-7711-4485-f134-a8c802c0a800/preview",
		"publish": true
	},
	"devDependencies": {
		"@types/node": "^22.19.1",
		"esbuild": "^0.27.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4",
		"wrangler": "4.56.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc && tsc -p server && vitest run && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "npm run seedLocalD1 && wrangler dev",
		"predeploy": "wrangler d1 migrations apply DB --remote",
		"seedLocalD1": "wrangler d1 migrations apply DB --local",
		"test": "vitest run",
		"build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --loader:.html=text --outfile=dist/server.mjs",
		"start:server": "node --disable-warning=ExperimentalWarning dist/server.mjs"
	}
}
